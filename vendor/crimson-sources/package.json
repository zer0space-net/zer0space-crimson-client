{
  "name": "crimson-sources",
  "version": "0.1.0",
  "private": true,
  "description": "Client-side scrape/resolve engine for Crimson Haven — the TS re-implementation of the backend sources, run in the viewer's browser (New System, Phase 1).",
  "type": "module",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
