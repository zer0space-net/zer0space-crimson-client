# Local development only. In production the app talks to the same-origin,
# dashboard-proxied /crimson/api and needs none of this.

# Where `npm run dev` proxies /crimson/api to (a running Crimson Haven backend).
CRIMSON_API_ORIGIN=http://localhost:8080

# Override the API base the bundle uses. Defaults to /crimson/api — only set this
# for a standalone build that talks to a backend directly (CORS must then allow it).
# VITE_API_BASE=https://crimson.example.com
